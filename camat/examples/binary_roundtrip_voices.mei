<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
  <meiHead>
    <fileDesc>
      <titleStmt><title>Binary roundtrip: nine notes, three voices</title></titleStmt>
      <pubStmt><p>CAMAT teaching example; matches make_roundtrip_example().</p></pubStmt>
    </fileDesc>
  </meiHead>
  <music><body><mdiv><score>
    <scoreDef meter.count="4" meter.unit="4" key.sig="0">
      <staffGrp symbol="bracket">
        <staffDef n="1" lines="5" clef.shape="G" clef.line="2"><label>Upper</label></staffDef>
        <staffDef n="2" lines="5" clef.shape="G" clef.line="2"><label>Lower</label></staffDef>
        <staffDef n="3" lines="5" clef.shape="G" clef.line="2"><label>Echo</label></staffDef>
      </staffGrp>
    </scoreDef>
    <section><measure n="1" xml:id="toy-measure" right="end">
      <staff n="1"><layer n="1">
        <note xml:id="toy-2" pname="d" oct="4" dur="8"/>
        <note xml:id="toy-3" pname="d" oct="4" dur="8"/>
        <rest dur="16"/>
        <note xml:id="toy-4" pname="g" oct="4" dur="8" dots="1"/>
        <note xml:id="toy-6" pname="g" oct="4" dur="4"/>
        <rest dur="16"/>
        <note xml:id="toy-8" pname="g" oct="4" dur="8"/>
        <rest dur="16"/>
      </layer></staff>
      <staff n="2"><layer n="1">
        <note xml:id="toy-0" pname="c" oct="4" dur="2"/>
        <note xml:id="toy-5" pname="e" oct="4" dur="4"/>
        <rest dur="4"/>
      </layer></staff>
      <staff n="3"><layer n="1">
        <rest dur="8"/>
        <note xml:id="toy-1" pname="c" oct="4" dur="8"/>
        <rest dur="8"/>
        <note xml:id="toy-7" pname="c" oct="5" dur="8"/>
        <rest dur="2"/>
      </layer></staff>
    </measure></section>
  </score></mdiv></body></music>
