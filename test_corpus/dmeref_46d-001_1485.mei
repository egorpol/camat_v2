    <body>
      <mdiv n="1" xml:id="mdiv_46d001">
        <score xml:id="score_46d001">
          <scoreDef key.mode="major" key.pname="c" keysig="0" meter.count="4" meter.sym="common" meter.unit="4" optimize="false" xml:id="scoreDef_01">
            <staffGrp bar.thru="true" symbol="bracket" xml:id="staffGrp_01">
              <staffDef clef.line="2" clef.shape="G" decls="#instrVoice_1" doxml.id="d27e29" lines="5" n="1" xml:id="staffDef_P1">
                <label xml:id="label_P1">Violino</label>
